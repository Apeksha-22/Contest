class Solution {
public:
    int minCost(vector<vector<int>>& grid) {
        vector<vector<int>> tem = grid;
        int m = tem.size(), n = tem[0].size();

        vector<vector<vector<bool>>> dp(
            m, vector<vector<bool>>(n, vector<bool>(1024, 0)));

        dp[0][0][tem[0][0]] = 1;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                for (int x = 0; x < 1024; x++) {
                    if (!dp[i][j][x])
                        continue;

                    if (i + 1 < m) {
                        int nx = x ^ tem[i + 1][j];
                        dp[i + 1][j][nx] = 1;
                    }
                    if (j + 1 < n) {
                        int nx = x ^ tem[i][j + 1];
                        dp[i][j + 1][nx] = 1;
                    }
                }
            }
        }

        for (int x = 0; x < 1024; x++) {
            if (dp[m - 1][n - 1][x])
                return x;
        }

        return 0;
    }
};
