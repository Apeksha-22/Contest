class Solution {
public:
    const int mod = 1e9 + 7;

    long long pw(long long a, long long b) {
        long long r = 1;
        while (b) {
            if (b & 1)
                r = r * a % mod;
            a = a * a % mod;
            b >>= 1;
        }
        return r;
    }

    int countVisiblePeople(int n, int pos, int k) {
        if (k > n - 1)
            return 0;

        vector<long long> f(n + 1, 1), inv(n + 1, 1);

        for (int i = 1; i <= n; i++)
            f[i] = f[i - 1] * i % mod;

        inv[n] = pw(f[n], mod - 2);
        for (int i = n - 1; i >= 0; i--)
            inv[i] = inv[i + 1] * (i + 1) % mod;

        long long c = f[n - 1] * inv[k] % mod * inv[n - 1 - k] % mod;

        return (2 * c) % mod;
    }
};
