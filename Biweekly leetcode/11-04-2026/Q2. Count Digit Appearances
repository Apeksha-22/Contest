class Solution {
public:
    int countDigitOccurrences(vector<int>& nums, int digit) {
        vector<int> temp = nums;
        int ans = 0;

        for (int x : temp) {
            while (x) {
                if (x % 10 == digit)
                    ans++;
                x /= 10;
            }
        }
        return ans;
    }
};
