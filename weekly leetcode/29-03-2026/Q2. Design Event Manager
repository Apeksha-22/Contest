class EventManager {
public:
    priority_queue<pair<int,int>> pq;
    unordered_map<int,int> mp;

    EventManager(vector<vector<int>>& ev) {
        for(auto &v: ev){
            int id = v[0], pr = v[1];
            mp[id] = pr;
            pq.push({pr, -id});
        }
    }
    
    void updatePriority(int id, int np) {
        mp[id] = np;
        pq.push({np, -id});
    }
    
    int pollHighest() {
        while(!pq.empty()){
            auto [pr, nid] = pq.top();
            int id = -nid;
            
            if(mp.count(id) && mp[id] == pr){
                pq.pop();
                mp.erase(id);
                return id;
            }
            pq.pop();
        }
        return -1;
    }
};

