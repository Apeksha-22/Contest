class Solution {
public:
    vector<double> internalAngles(vector<int>& sides) {
        vector<int> temp = sides;
        vector<double> ans;

        double a = temp[0];
        double b = temp[1];
        double c = temp[2];

        vector<double> s = {a, b, c};
        sort(s.begin(), s.end());

        if (s[0] + s[1] <= s[2])
            return ans;

        double A = acos((b * b + c * c - a * a) / (2 * b * c));
        double B = acos((a * a + c * c - b * b) / (2 * a * c));
        double C = acos((a * a + b * b - c * c) / (2 * a * b));

        double pi = acos(-1);

        ans.push_back(A * 180 / pi);
        ans.push_back(B * 180 / pi);
        ans.push_back(C * 180 / pi);

        sort(ans.begin(), ans.end());

        return ans;
    }
};
