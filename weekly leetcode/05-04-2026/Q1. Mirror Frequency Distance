class Solution {
public:
    int mirrorFrequency(string s) {
        vector<int> freq(36, 0);

        for (char c : s) {
            if (isdigit(c)) {
                freq[26 + (c - '0')]++;
            } else {
                freq[c - 'a']++;
            }
        }

        int ans = 0;
        for (int i = 0; i < 26; i++) {
            int j = 25 - i;

            if (i <= j) {
                ans += abs(freq[i] - freq[j]);
            }
        }
        for (int i = 0; i < 10; i++) {
            int j = 9 - i;

            if (i <= j) {
                ans += abs(freq[26 + i] - freq[26 + j]);
            }
        }
        return ans;
    }
};
